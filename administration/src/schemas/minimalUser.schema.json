{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MinimalUser",
    "type": "object",
    "required": [
        "id",
        "displayName",
        "roles",
        "isActive"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "displayName": {
            "type": "string"
        },
        "roles": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "admin",
                    "evaluator",
                    "copywriter",
                    "reviewer",
                    "viewer"
                ]
            }
        },
        "isActive": {
            "type": "boolean"
        }
    },
    "additionalProperties": false
}